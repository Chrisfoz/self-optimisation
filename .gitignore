# Reference papers — third-party copyrighted material, kept local only.
# See docs/SOURCES.md for the citation list.
docs/*.pdf
docs/*.docx
docs/*.epub

# OS / editor cruft
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*~
.vscode/
.idea/

# OneDrive / Office lock files
~$*
*.tmp

# Secrets — never commit real API keys. Copy harness/.env.example to .env
# and fill it in locally; .env is read by `node --env-file=.env`, not by git.
.env
.env.*
!.env.example

# Runtime state a local rehearsal writes (which models have been seen before)
.agent/
node_modules/
