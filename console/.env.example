# Set these in Railway Variables; never commit real credentials.
CONSOLE_ORIGIN=https://console-production-763f.up.railway.app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Railway supplies PORT automatically.
# PORT=3000

# Optional: install the shared harness (a short workflow calling this
# repository's shared workflow at one commit) instead of copying harness/ into
# every repository. Leave unset while this repository is private: other
# repositories cannot read it. See console/DEPLOYMENT.md, "Shared harness".
# SELF_OPTIMISATION_SHARED_REF=<full 40-character commit sha>
# SELF_OPTIMISATION_SHARED_LABEL=v0.1.0
# SELF_OPTIMISATION_SHARED_REPOSITORY=Chrisfoz/self-optimisation
