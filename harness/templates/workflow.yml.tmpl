# Generated by harness/cli/init.mjs from harness/templates/workflow.yml.tmpl —
# regenerate by re-running init rather than hand-patching this file where you
# can, so the two don't drift. See SELF-IMPROVE-README.md (written alongside
# this file) for what it does and how to rehearse it before turning the
# schedule on.
#
# One job, sequential steps, not the reference implementation's several —
# GitHub Actions cannot loop or dynamically branch jobs (see ARCHITECTURE.md's
# "reference implementation, concretely" diagram, which names this
# explicitly), and passing state between jobs would mean serialising it
# through artifacts for no real benefit here. Every gate still runs, in the
# same order: detect -> probe -> preflight -> improve -> themes -> guard ->
# test -> promote (or open a pull request) -> verify -> notify. A gate that fails does not fail the whole job
# (`continue-on-error: true`) — it fails CLOSED further down instead, via the
# `if:` on the step that depends on it, so the digest step still runs and
# reports exactly what happened either way.
#
# `shell: bash` is pinned explicitly on every multi-line step — see
# Portable-Harness-Design.md §8.3 for why that's what makes it safe to change
# `runs-on` below to a different runner later.
#
# Every value that could contain model-generated or otherwise untrusted text
# (a proposal summary, brief feedback) is passed through `env:` and read back
# with `$VAR` inside the script, never interpolated directly into a `run:`
# block via `${{ }}` — that's the difference between a safe workflow and a
# script-injection bug, not a style preference. See GitHub's own docs on
# "Understanding the risk of script injection" if you extend this file.
#
# TWO THINGS THIS FILE IS RENDERED WITH, both chosen at scaffold time and
# both visible below as ordinary YAML rather than as a runtime branch:
#
# 1. The MERGE MODEL, from `constitution.approval_class`.
#    `human-approval-required` (the default, and what anything unrecognised
#    falls back to) runs every gate against the agent branch and then opens
#    a pull request for a person to merge — `console/DESIGN.md` §Step 7:
#    "defaulting a non-technical user into autonomous merge is the single
#    worst decision this console could make". `autonomous-merge` is the
#    opt-in that merges and tags the branch itself
#    (harness/scripts/promote.mjs). Exactly one of the two paths is
#    rendered into this file; the other does not exist here at all, so
#    which one a repository got is answerable by reading it.
# 2. The SCHEDULE, which may be absent. §Step 9's two-phase onboarding
#    ships `workflow_dispatch` only, rehearses once by hand, and adds the
#    `schedule:` block afterward — so that "the schedule stays off until a
#    rehearsal passes" is literally true rather than aspirational.
#
# `harness/lib/orchestrator.mjs`'s `recordPullRequestUrl()` and
# `harness/scripts/record-pull-request.mjs` are what the pull-request path
# calls to write the PR's URL back into that generation's attempts.json.

name: Self-improvement loop

on:
{{TRIGGERS}}

permissions:
{{PERMISSION_LINES}}

{{CONCURRENCY_BLOCK}}

jobs:
  # A manual pre-flight for the keys themselves, separate from the loop.
  # `validate.mjs` reports a key that is ABSENT; this asks whether the keys
  # that ARE there work, and what money is behind them. Run it before turning
  # the schedule on, and after rotating a key. It calls each lab's model
  # listing and nothing else: no model is invoked, so it costs nothing.
  # Never runs on the schedule — only when someone asks for it.
  check-keys:
    if: {{INPUTS}}.check_keys == 'true'
    runs-on: {{RUNNER}}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2

      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: '{{NODE_VERSION}}'

      {{HARNESS_SETUP_STEPS}}

      - name: Check every configured key
        shell: bash
        env:
{{PROVIDER_ENV_LINES}}
{{NOTIFY_ENV_LINE}}
        run: node {{HARNESS}}/scripts/check-keys.mjs

  self-improve:
    # The keys check is a separate errand: asking for it should not also
    # spend a generation.
    if: {{INPUTS}}.check_keys != 'true'
    runs-on: {{RUNNER}}
    steps:
      # Actions pinned by commit SHA, not by tag, and the one npm package
      # pinned to an exact version with lifecycle scripts disabled. This
      # job holds a token that can write to the repository; a tag can be
      # moved and a floating version can be replaced, and either would run
      # inside every gate rather than having to defeat one. See
      # learning/03-failure-modes.md Part 9, "Supply chain, on the build
      # side". Bump the SHA and the version together, on purpose.
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0

      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: '{{NODE_VERSION}}'

      # The project's own dependencies, before anything runs its tests. A
      # copied installation has no other step that does this, and preflight
      # runs the project's real test command: without it, `npm test` exits 127
      # (command not found), preflight fails, and every generation is skipped
      # before it starts — a loop that mails "nothing happened" every cycle.
      # Empty when a project needs no setup (a suite that runs on Node's own
      # test runner with zero dependencies, say), in which case this whole
      # step disappears from the file.
{{PROJECT_SETUP_STEPS}}
      {{HARNESS_SETUP_STEPS}}

      # Once, for every step that commits. It used to be set only by the
      # snapshot step, which campaign runs skip — so on a campaign run the
      # pull-request read-back's commit failed on a missing identity, and
      # its `|| echo` reported that as "Nothing to record".
      - name: Configure the bot's git identity
        shell: bash
        run: |
          git config user.email "self-improvement-bot@github-actions.local"
          git config user.name "Self-Improvement Bot"

      # The kill switch. A repository VARIABLE (not a secret — it is not
      # sensitive, and a variable can be read back and seen in the UI),
      # settable by anyone with settings access and requiring no edit to
      # this file. When it is "true" the run stops here: no lab is polled,
      # no model is called, nothing is spent — and the digest step at the
      # bottom still runs, so the inbox says "paused" rather than nothing.
      # Settings -> Secrets and variables -> Actions -> Variables ->
      # SELF_IMPROVE_PAUSED = true.
      - name: Is the loop paused?
        id: pause
        shell: bash
        env:
          PAUSED: ${{ vars.SELF_IMPROVE_PAUSED }}
        run: |
          if [ "$PAUSED" = "true" ]; then
            echo "paused=true" >> "$GITHUB_OUTPUT"
            echo "SELF_IMPROVE_PAUSED is set. Stopping before anything is polled or spent."
          else
            echo "paused=false" >> "$GITHUB_OUTPUT"
          fi

      # continue-on-error for the same reason the release check below has
      # it: a bad config must not kill the job before the digest gets to
      # report it. Its outcome is passed to the digest as VALIDATE_RESULT
      # and checked ahead of CHECK_RESULT, so an invalid adapter is never
      # reported as a quiet cycle — see harness/lib/validate.mjs, and
      # harness/scripts/rehearse.mjs, which runs the identical check before
      # a local rehearsal for the same reason.
      - name: Validate the project's adapter
        id: validate
        if: steps.pause.outputs.paused != 'true'
        shell: bash
        continue-on-error: true
        env:
{{PROVIDER_ENV_LINES}}
        run: {{VALIDATE_RUN}}

      # Campaign mode (harness/lib/campaign.mjs): the owner named models from
      # the Actions tab, so the release check is skipped and the same
      # release-check.json is written by hand. Everything downstream — probe,
      # preflight, improve — runs unchanged, and the record is stamped
      # campaign: true so release-driven history stays distinguishable.
      - name: Use the models named by hand (campaign mode)
        id: campaign
        if: steps.pause.outputs.paused != 'true' && steps.validate.outcome == 'success' && {{INPUTS}}.models
        shell: bash
        env:
          CAMPAIGN_MODELS: ${{ {{INPUTS}}.models }}
        run: |
          node {{HARNESS}}/scripts/campaign-models.mjs > "$RUNNER_TEMP/release-check.json"
          echo "has-new=true" >> "$GITHUB_OUTPUT"

      # continue-on-error so a crashed release check cannot kill the job
      # before the digest step gets to report that it crashed. Its outcome is
      # read back below and passed to the digest as CHECK_RESULT — without
      # that, "the check never ran" is indistinguishable from "the check ran
      # and found nothing", and a broken cycle reports as a calm one.
      - name: Check for new model releases
        id: check
        if: steps.pause.outputs.paused != 'true' && steps.validate.outcome == 'success' && !{{INPUTS}}.models
        shell: bash
        continue-on-error: true
        env:
{{PROVIDER_ENV_LINES}}
        run: |
          node {{HARNESS}}/scripts/check-model-releases.mjs \
            --providers {{PROVIDERS_CSV}} \
            > "$RUNNER_TEMP/release-check.json"
          echo "has-new=$(jq -r '.hasNewReleases' "$RUNNER_TEMP/release-check.json")" >> "$GITHUB_OUTPUT"
          # Set before any probe runs and never overwritten by one — see
          # harness/lib/model-release-detector.mjs. This is what tells a
          # cycle where the probe dropped everything apart from a quiet one.
          echo "release-detected=$(jq -r '.releaseDetected' "$RUNNER_TEMP/release-check.json")" >> "$GITHUB_OUTPUT"

      - name: Commit the updated model snapshot
        if: steps.pause.outputs.paused != 'true' && steps.validate.outcome == 'success' && !{{INPUTS}}.models
        shell: bash
        run: |
          git config user.email "self-improvement-bot@github-actions.local"
          git config user.name "Self-Improvement Bot"
          git add {{SNAPSHOT_PATH}}
          git commit -m "Update model snapshot" || echo "No change to commit"
          git push

      # The fate of earlier generations' pull requests, read back into their
      # records before this cycle decides anything: a person merging or
      # closing is the one verdict in the loop that is not the harness
      # grading itself, and it feeds the next prompt's history and the
      # earned-ambition check. Finds nothing on the autonomous-merge path,
      # which is fine. continue-on-error: bookkeeping must not stop a cycle.
      - name: Read back the fate of earlier pull requests
        id: prs
        if: steps.pause.outputs.paused != 'true'
        shell: bash
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          node {{HARNESS}}/scripts/sync-pull-request-outcomes.mjs --generations-dir {{GENERATIONS_DIR}}
          # The operational report (REPORT.md, the paper's §7 metrics) and the
          # run history (index.html, the owner's page), generated from the
          # records and never hand-edited. Regenerated here, after the
          # read-back, so a merge or close since the last run shows up. Both
          # are rebuilt again when this run's record is persisted. See
          # harness/lib/report.mjs and harness/lib/run-history.mjs.
          node {{HARNESS}}/scripts/report.mjs --generations-dir {{GENERATIONS_DIR}}
          git add -A -- {{GENERATIONS_DIR}}
          git commit -m "Record pull request outcomes and regenerate the report" || echo "Nothing to record"
          git push

      # The probe makes a real, one-word call to every candidate, so it needs
      # the same keys the release check does. Without them every candidate
      # reads as unreachable and the cycle is skipped before it starts —
      # which is exactly what this step did until it was given them.
      - name: Probe reachability, then read the survivors
        id: probe
        if: steps.check.outputs.has-new == 'true' || steps.campaign.outputs.has-new == 'true'
        shell: bash
        env:
{{PROVIDER_ENV_LINES}}
        run: |
          node {{HARNESS}}/scripts/probe-models.mjs "$RUNNER_TEMP/release-check.json"
          echo "has-new=$(jq -r '.hasNewReleases' "$RUNNER_TEMP/release-check.json")" >> "$GITHUB_OUTPUT"
          # Which candidates were dropped, and why — the difference between
          # "nothing shipped" and "something shipped that we could not call".
          echo "dropped=$(jq -c '[.probeDropped[]? | "\(.id): \(.reason)"] | join("; ")' "$RUNNER_TEMP/release-check.json")" >> "$GITHUB_OUTPUT"
          # A pinned seat (implement, review, a named ranker, the digest
          # writer) that could not answer. The cycle is skipped before any
          # suggester is paid for, and the run is turned red at the end.
          echo "pinned-blocked=$(jq -r '(.pinnedUnreachable // []) | length > 0' "$RUNNER_TEMP/release-check.json")" >> "$GITHUB_OUTPUT"
          echo "models=$(jq -c '.selectedModels' "$RUNNER_TEMP/release-check.json")" >> "$GITHUB_OUTPUT"
          echo "model=$(jq -r '.selectedModel // "none"' "$RUNNER_TEMP/release-check.json")" >> "$GITHUB_OUTPUT"
          echo "provider=$(jq -r '.selectedProvider // "none"' "$RUNNER_TEMP/release-check.json")" >> "$GITHUB_OUTPUT"

      - name: Run this project's own tests (preflight — baseline must be green before spending anything)
        id: preflight
        if: steps.probe.outputs.has-new == 'true'
        shell: bash
        continue-on-error: true
        run: |
{{PREFLIGHT_COMMAND_LINES}}

      # The next number is one past the highest in any trace a generation
      # leaves — a gen-NNN tag, an agent/gen-NNN branch, a gen-NNN record
      # on {{DEFAULT_BRANCH_LABEL}} — and the branch is claimed on the remote with
      # a lease that fails if it already exists, before anything is spent.
      # It used to read tags alone, which only autonomous merge creates, so
      # on the pull-request path every run was generation 001 and each
      # overwrote the last one's record. See harness/lib/generation-id.mjs.
      - name: Claim the next generation number and its branch
        id: gen
        if: steps.preflight.outcome == 'success'
        shell: bash
        run: |
          git config user.email "self-improvement-bot@github-actions.local"
          git config user.name "Self-Improvement Bot"
          node {{HARNESS}}/scripts/next-generation.mjs --base {{DEFAULT_BRANCH}} --remote origin --generations-dir {{GENERATIONS_DIR}}

      # The same evaluators as the step after the loop, on the tree as it is
      # BEFORE any change — so the numbers measured afterwards have something
      # to be compared against (harness/lib/measure.mjs writes
      # comparison.json: benefits, regressions, and what the generation
      # cost). Never gating, like every evaluator. A project with none
      # configured runs this and it says so.
      - name: Measure the baseline, before any change (never gating)
        id: baseline
        if: steps.gen.outputs.number
        shell: bash
        continue-on-error: true
        env:
          GEN_NUMBER: ${{ steps.gen.outputs.number }}
        run: node {{HARNESS}}/scripts/run-evaluators.mjs --baseline

      - name: Run the improvement loop
        id: improve
        if: steps.gen.outputs.number
        shell: bash
        continue-on-error: true
        env:
{{PROVIDER_ENV_LINES}}
          GEN_NUMBER: ${{ steps.gen.outputs.number }}
          RUN_ID: ${{ steps.gen.outputs.run-id }}
          RUN_URL: ${{ steps.gen.outputs.run-url }}
          # Game-only research: disabled unless repository variable is true.
          GAME_REFERENCE_WEB_SEARCH: ${{ vars.GAME_REFERENCE_WEB_SEARCH }}
          GAME_REFERENCE_WEB_QUERY: ${{ vars.GAME_REFERENCE_WEB_QUERY }}
          BRAVE_SEARCH_API_KEY: ${{ secrets.BRAVE_SEARCH_API_KEY }}
          SUGGEST_MODELS: ${{ steps.probe.outputs.models }}
          SCOPE: ${{ {{INPUTS}}.scope }}
          CAMPAIGN: ${{ steps.campaign.outputs.has-new }}
        run: node {{HARNESS}}/scripts/run-generation.mjs

      # The measurements that are NOT gates — quality dimensions beyond
      # pass/fail, run against the tree this generation produced. A plugin
      # cannot fail a generation, cannot stop a merge and cannot block a
      # pull request: the script exits 0 even when every plugin it loaded
      # blew up, and records that it did. See
      # harness/plugins/evaluators/README.md. A project with no
      # `evaluation.evaluators` configured runs this and it says so.
      - name: Measure this project's quality dimensions (never gating)
        id: evaluators
        if: steps.improve.outputs.has-changes == 'true'
        shell: bash
        continue-on-error: true
        env:
          GEN_NUMBER: ${{ steps.gen.outputs.number }}
        run: node {{HARNESS}}/scripts/run-evaluators.mjs

      # Every {{THEMES_CADENCE}} generations, one model reads the same
      # history window every suggesting model reads and is asked what
      # principle explains it — abstraction rather than association. The
      # script decides for itself whether this run is a cadence boundary
      # and exits 0 saying so when it isn't, which is why it can run every
      # generation instead of needing a second schedule kept in sync with
      # this one. continue-on-error because a missed review is a missed
      # review: the generation itself already succeeded, and this must not
      # roll it back.
      #
      # It runs here, before the commit below, so the review rides the same
      # commit as the generation it reviews. The consequence, stated rather
      # than discovered: a cadence boundary reached on a run that shipped
      # nothing has no commit to ride, and that boundary is skipped — the
      # next one picks it up, or `FORCE_REVIEW=true` via workflow_dispatch
      # does it by hand.
      - name: Themes review, if this generation is a cadence boundary
        id: themes
        if: steps.improve.outputs.has-changes == 'true'
        shell: bash
        continue-on-error: true
        env:
{{PROVIDER_ENV_LINES}}
          GEN_NUMBER: ${{ steps.gen.outputs.number }}
        run: node {{HARNESS}}/scripts/generate-themes-review.mjs

      - name: Commit and push the agent branch, if it has changes
        if: steps.improve.outputs.has-changes == 'true'
        shell: bash
        env:
          BRANCH: ${{ steps.gen.outputs.branch }}
          GEN_NUMBER: ${{ steps.gen.outputs.number }}
          SUMMARY: ${{ steps.improve.outputs.summary }}
        # The code change and nothing else. The harness's own record of this
        # run (attempts.json, the proposal, the ledger, a themes review) is
        # committed to {{DEFAULT_BRANCH_LABEL}} by the persist step below, on every
        # outcome — not here, where it would reach {{DEFAULT_BRANCH_LABEL}} only if
        # the pull request merged, and would conflict with the pull-request
        # read-back writing into the same file while the PR is open.
        #
        # Both editable surfaces: allowed_paths AND create_only_paths. A new
        # file (a new test, say) used to be left out, so the tests passed
        # against the runner's untracked copy and the pull request shipped
        # without it. One pathspec at a time, because `git add` on a glob
        # that matches nothing is fatal under bash -e.
        run: |
          {{EDITABLE_PATHS_PREAMBLE}}for p in {{EDITABLE_PATHS_GIT_ADD}}; do
            if [ -n "$(git status --porcelain -- "$p")" ]; then git add -A -- "$p"; fi
          done
          git commit -m "Generation $GEN_NUMBER: $SUMMARY"
          git push origin "$BRANCH"

      - name: Guard — enforce frozen/append-only paths on the agent branch
        id: guard
        if: steps.improve.outputs.has-changes == 'true'
        shell: bash
        continue-on-error: true
        run: node {{HARNESS}}/scripts/check-guarded-paths.mjs "origin/{{DEFAULT_BRANCH}}"

      - name: Run this project's own tests, against the agent branch
        id: tests
        if: steps.guard.outcome == 'success'
        shell: bash
        continue-on-error: true
        run: |
{{TEST_COMMAND_LINES}}

      {{MERGE_STEPS}}

      # What this run actually SAW, as opposed to what it decided. Written
      # so the NEXT generation's prompt can read it: every other signal in
      # that prompt describes what the project IS, and until this step
      # existed nothing described what it DID. See
      # docs/curiosity/C10-runtime-evidence.md, and the incident behind it —
      # a defect 239 green checks had never noticed, found on the first run
      # of something that actually looked at the running product.
      #
      # Runs last, and `always()`, because the observations arrive at
      # different points: the tests early, the deployment check at the very
      # end. It commits to {{DEFAULT_BRANCH_LABEL}} rather than to the agent
      # branch, for the same reason the model snapshot does — this is the
      # harness's own bookkeeping, and it has to be readable by the next run
      # whether or not this generation's pull request is ever merged.
      #
      # HOW YOUR TESTS CONTRIBUTE: this records a TAP stream at
      # $RUNNER_TEMP/tests.tap if one is there. Nothing writes it for you,
      # because your test command is yours — a project whose runner can emit
      # TAP (`node --test --test-reporter=tap`, pytest --tap, and others)
      # tees it there; any other project writes a JSON fragment instead and
      # passes it with --fragment. Contributing nothing is also fine: the
      # section shrinks rather than lying.
      - name: Record what this run observed at runtime
        id: evidence
        if: always() && steps.gen.outputs.number
        shell: bash
        continue-on-error: true
        env:
          GEN_NUMBER: ${{ steps.gen.outputs.number }}
        run: |
          args=()
          if [ -f "$RUNNER_TEMP/tests.tap" ]; then args+=(--tap "$RUNNER_TEMP/tests.tap" --tap-name "this project's own tests"); fi
          if [ -f "$RUNNER_TEMP/deploy-evidence.json" ]; then args+=(--fragment "$RUNNER_TEMP/deploy-evidence.json"); fi
          node {{HARNESS}}/scripts/record-runtime-evidence.mjs "${args[@]}"

      # Every outcome — approved, abandoned, crashed, no proposal, over
      # budget — commits its record to {{DEFAULT_BRANCH_LABEL}}: the generation's
      # directory, the escalation ledger, a themes review, the runtime
      # evidence above. Done in a temporary worktree, so this job's own
      # checkout is never switched; only files this run changed are copied;
      # and a push that loses a race retries on the new tip. Until this
      # existed, a failed generation's record was deleted with the runner,
      # and the failures were exactly what the next run could not see. Its
      # outcome is reported to the digest as the `records` gate.
      - name: Persist this generation's record to {{DEFAULT_BRANCH_LABEL}}
        id: persist
        if: always() && steps.gen.outputs.number
        shell: bash
        continue-on-error: true
        env:
          GEN_NUMBER: ${{ steps.gen.outputs.number }}
        run: node {{HARNESS}}/scripts/persist-records.mjs --base {{DEFAULT_BRANCH}} --remote origin

      # Gate results only exist when a generation was actually attempted.
      # The digest step below is NOT gated on that — see its own comment.
      - name: Build this run's gate results
        id: gates
        if: always() && steps.gen.outputs.number
        shell: bash
        env:
          PREFLIGHT: ${{ steps.preflight.outcome }}
          # The loop step fails for a rejected change AND for a crash, an
          # empty fan-out or a budget refusal. Labelled "review" whatever
          # happened, a run that crashed on an empty credit balance reported
          # "❌ review" when nothing was ever reviewed. The verdict says which.
          IMPROVE: ${{ steps.improve.outcome }}
          REVIEW_VERDICT: ${{ steps.improve.outputs.review-verdict }}
          GUARD: ${{ steps.guard.outcome }}
          TESTS: ${{ steps.tests.outcome }}
          # Exactly one of these two paths was rendered into this file (see
          # the header). The other's step does not exist, so its `outcome`
          # expression resolves to the empty string and `add` skips it —
          # which is why this block can name both without either merge
          # model having to know about the other.
          PULL_REQUEST: ${{ steps.pr.outcome }}
          PROMOTE: ${{ steps.promote.outcome }}
          VERIFY: ${{ steps.verify.outcome }}
          RECORDS: ${{ steps.persist.outcome }}
        # `add` returns 0 explicitly when it skips. GitHub runs this under
        # `bash -eo pipefail`; the old one-liner `[ -n "$2" ] && ...` returned
        # 1 for the absent path, and -e killed the step on it — on EVERY run,
        # in both merge models, since one of the two paths is always absent.
        # tests/scripts/workflow-shell.test.mjs runs this block under those
        # exact flags.
        run: |
          gates='[]'
          add() {
            if [ -z "$2" ]; then return 0; fi
            gates=$(printf '%s' "$gates" | jq -c --arg n "$1" --arg r "$2" '. + [{name:$n, result:$r}]')
          }
          add preflight "$PREFLIGHT"
          # A review gate only when a review happened; otherwise the loop's
          # own result, under its own name.
          case "$REVIEW_VERDICT" in
            approved) add review success ;;
            rejected) add review failure ;;
            *) add improve "$IMPROVE" ;;
          esac
          add guard "$GUARD"
          add tests "$TESTS"
          add pull-request "$PULL_REQUEST"
          add promote "$PROMOTE"
          add verify "$VERIFY"
          add records "$RECORDS"
          echo "json=$gates" >> "$GITHUB_OUTPUT"
          merged=false
          if [ "$PROMOTE" = "success" ]; then merged=true; fi
          echo "merged=$merged" >> "$GITHUB_OUTPUT"
      {{NOTIFY_STEPS}}

      # Last, after the digest has had its say: a generation whose record
      # could not be saved turns the whole run red. The persist step is
      # continue-on-error so nothing after it is skipped, which on its own
      # meant a lost record looked like a green run — the first real run on
      # GitHub Actions lost one exactly that way. A red run is the one signal
      # that reaches someone with no digest configured.
      - name: Fail the run if this generation's record was not saved
        if: always() && steps.persist.outcome == 'failure'
        shell: bash
        run: |
          echo "::error::This generation's record could not be committed to {{DEFAULT_BRANCH}} — see the persist step. It exists only on this runner and is gone when the job ends."
          exit 1

      # The same reasoning as the step above, for two more ways a run looked
      # green while achieving nothing. A REJECTED change stays green: that is
      # the gates working. A crash is not. The first real run on GitHub Actions
      # crashed on an empty credit balance and showed a green tick.
      - name: Fail the run if the improvement loop crashed
        if: always() && steps.improve.outcome == 'failure' && steps.improve.outputs.review-verdict == ''
        shell: bash
        run: |
          echo "::error::The improvement loop crashed before reaching a verdict — see the 'Run the improvement loop' step. Its record says why."
          exit 1

      - name: Fail the run if a pinned model could not be reached
        if: always() && steps.probe.outputs.pinned-blocked == 'true'
        shell: bash
        env:
          DROPPED: ${{ steps.probe.outputs.dropped }}
        run: |
          echo "::error::A pinned seat could not be reached, so the cycle stopped before spending anything: $DROPPED"
          exit 1
